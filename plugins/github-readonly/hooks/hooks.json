{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "exit 2"
          },
          {
            "type": "command",
            "if": "Bash(git * push *)",
            "command": "exit 2"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "exit 2"
          },
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "exit 2"
          },
          {
            "type": "command",
            "if": "PowerShell(git * push *)",
            "command": "exit 2"
          },
          {
            "type": "command",
            "if": "PowerShell(gh *)",
            "command": "exit 2"
          }
        ]
      }
    ]
  }
}
